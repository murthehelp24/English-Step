# English Steps Environment Configuration
# Copy this file to .env.local and fill in your keys. NEVER commit .env.local to Git.

# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Owner Authorization & Multi-Learner Extensibility ---
OWNER_EMAIL=owner@example.com
# Set both to true later when opening registration for additional learners (each user's data is isolated via Supabase RLS)
ALLOW_MULTI_USER=false
NEXT_PUBLIC_ALLOW_SIGNUP=false

# --- AI Provider Configuration ---
# Choose provider: gemini | openai | anthropic
AI_PROVIDER=gemini
AI_API_KEY=your_ai_provider_api_key_here
AI_MODEL=gemini-1.5-flash
AI_MONTHLY_BUDGET_USD=10.00

# --- App Settings ---
NEXT_PUBLIC_APP_TIMEZONE=Asia/Bangkok
